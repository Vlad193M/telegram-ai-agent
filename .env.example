# --- Telegram (my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
# file name for the session (stored as <name>.mtcute.session, never commit it)
TG_SESSION=agent

# Username of the restaurant manager the agent talks to (your test account while testing).
TARGET_USERNAME=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Agent ---
# seconds to wait for more messages before replying (people often send 2-3 in a row)
DEBOUNCE_SECONDS=4
# if the manager goes quiet, the agent may send a polite follow-up after this many minutes (max 2 times)
FOLLOW_UP_MINUTES=3